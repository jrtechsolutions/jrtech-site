# URL pública do site (usada em sitemap, Open Graph, etc.)
NEXT_PUBLIC_SITE_URL=https://jrtechnologysolutions.com.br

# E-mail exibido no site
NEXT_PUBLIC_CONTACT_EMAIL=contato@jrtechnologysolutions.com.br

# Número do WhatsApp (apenas dígitos, com código do país — ex: 5511973802744)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Endpoint PHP de contato no Plesk (httpdocs/api/contact.php)
CONTACT_API_URL=https://jrtechnologysolutions.com.br/api/contact.php

# Mesmo valor do arquivo .contact_token no servidor (header X-JR-Contact-Token)
# Nunca exponha no client — só no .env do Next / Vercel
CONTACT_API_TOKEN=
